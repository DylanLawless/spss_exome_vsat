df <- df |> filter(genotype > 0)
df <- merge( df, df_genotype_frequency, all.x=TRUE)
rm(df_genotype_frequency)
# Import ----
df_acmg <- read.table("../data/acgm_criteria_table.txt", sep = "\t", header = TRUE)
df_acmg_caveat <-
read.table("../data/acgm_criteria_table_caveats.txt", sep = "\t", header = TRUE)
df$ACMG_PVS1 <- NA
df$ACMG_PVS1 <- NA
df <- df %>% dplyr::select(ACMG_PVS1, everything())
df$ACMG_PVS1 <- ifelse(df$IMPACT == "HIGH" | df$genotype == 2, "PVS1", NA)
# PS1 ----
# PS1 Same amino acid change as a previously established pathogenic variant regardless of nucleotide change. Note to keep splicing variant as PSV1 (these are covered by IPACT HIGH).
df$ACMG_PS1 <- NA
df <- df %>% dplyr::select(ACMG_PS1, everything())
names(df)
df$ACMG_PS1 <- ifelse(df$CLIN_SIG == "pathogenic", "PS1", NA)
df <- df %>% dplyr::select(ACMG_PS1, everything())
df$ACMG_PS1 <- ifelse(df$CLIN_SIG == "pathogenic", "PS1", NA)
df$ACMG_PS4 <- NA
View(df_acmg)
df_acmg
names(df)
# Tally up the results ----
df$ACMG_higest <- ifelse(!is.na(df$ACMG_PVS1), df$ACMG_PVS1,
ifelse(!is.na(df$ACMG_PS1), df$ACMG_PS1, NA))
df <- df %>% select(ACMG_higest, everything())
# Count the number of non-NA values across the columns
df$ACMG_count <- rowSums(!is.na(df[, c("ACMG_PVS1", "ACMG_PS1")]))
df <- df %>% select(ACMG_count, everything())
df <- df %>% select(ACMG_count, everything())
# Tally up the results ----
df$ACMG_higest <- ifelse(!is.na(df$ACMG_PVS1), df$ACMG_PVS1,
ifelse(!is.na(df$ACMG_PS1), df$ACMG_PS1, NA))
df <- df %>% select(ACMG_higest, everything())
df <- df %>% dplyr::select(ACMG_higest, everything())
# Count the number of non-NA values across the columns
df$ACMG_count <- rowSums(!is.na(df[, c("ACMG_PVS1", "ACMG_PS1")]))
df <- df %>% dplyr::select(ACMG_count, everything())
# Replace 0's with NA
df$ACMG_count[df$ACMG_count == 0] <- NA
