mutate(cohort_pheno = ifelse(grepl("^setpt", sample), "0", "1")) %>%
group_by(rownames, cohort_pheno) %>%
summarize(genotype_total_frequency = sum(genotype)/n(), .groups = "drop") %>%
pivot_wider(names_from = cohort_pheno, values_from = genotype_total_frequency,
names_prefix = "frequency_in_")
# Keep only variants  ----
df <- df |> filter(genotype > 0)
View(df_genotype_frequency)
# Get frequency of each variant for cases and controls
library(tidyr)
df_genotype_frequency <- df %>%
mutate(cohort_pheno = ifelse(grepl("^setpt", sample), "0", "1")) %>%
group_by(rownames, cohort_pheno) %>%
summarize(genotype_total_frequency = sum(genotype)/n(), .groups = "drop") %>%
pivot_wider(names_from = cohort_pheno, values_from = genotype_total_frequency,
