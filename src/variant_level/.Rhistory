# Load the necessary library
# library(dplyr)
# library(stringr)
library(ggplot2)
plink.assoc <- read.table("../../data/variant_level/plink.assoc", header = TRUE)
head(plink.assoc)
plink.assoc$p_val <- plink.assoc$P
plink.assoc |>
sample_n(100) |>
ggplot( aes(x = rownames(plink.assoc), y = -log10(p_val))) +
geom_hline(yintercept = -log10(psig)) +
geom_point()
plink.assoc |>
sample_n(., 100) |>
ggplot( aes(x = rownames(plink.assoc), y = -log10(p_val))) +
geom_hline(yintercept = -log10(psig)) +
geom_point()
sample_n(plink.assoc, 100) |>
ggplot( aes(x = rownames(plink.assoc), y = -log10(p_val))) +
geom_hline(yintercept = -log10(psig)) +
geom_point()
