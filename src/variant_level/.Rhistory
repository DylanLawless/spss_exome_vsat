View(plink.assoc)
# Filter rows where F_A and F_U are not 0
plink.assoc.filtered <- plink.assoc %>%
filter(F_A != 0, F_U != 0)
View(plink.assoc.filtered)
plink.assoc.filtered |>
sample_n(10000) |>
ggplot( aes(x = row, y = -log10(p_val))) +
geom_hline(yintercept = -log10(psig)) +
geom_point()
p1 <- plink.assoc.filtered |>
sample_n(10000) |>
ggplot( aes(x = row, y = -log10(p_val))) +
geom_hline(yintercept = -log10(psig)) +
geom_point()
